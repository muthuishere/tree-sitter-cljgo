{
  "name": "tree-sitter-cljgo",
  "version": "0.0.13",
  "description": "Tree-sitter grammar for cljgo (Clojure hosted on Go), plus editor queries and a ctx-optimize pack",
  "tree-sitter": [
    {
      "scope": "source.cljgo",
      "file-types": [
        "cljgo",
        "cljg",
        "clj",
        "cljc"
      ],
      "highlights": [
        "queries/highlights.scm",
        "queries/cljgo-highlights.scm",
        "queries/generated/definers.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ],
  "scripts": {
    "gen": "node tools/gen-editors.js",
    "check": "node tools/gen-editors.js --check"
  }
}
